# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# Local dev
FRONTEND_ORIGIN="http://localhost:3001"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google/callback"

# Production (Render)
# FRONTEND_ORIGIN="https://cellsinvitro.vercel.app"
# GOOGLE_REDIRECT_URI="https://cellsinvitro.vercel.app/api/auth/google/callback"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
PORT=3000

# Razorpay (course payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email (Brevo — certificates & reminders)
BREVO_API_KEY=""
EMAIL_FROM="CellsInVitro <certificates@cellsinvitro.com>"

# Certificate verification
CERTIFICATE_SECRET="replace-with-a-long-random-string"

# Cloudinary (required for image uploads in Resource Library)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
