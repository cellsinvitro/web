generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String?
  name           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  googleId       String?          @unique
  avatarUrl      String?
  role           UserRole         @default(USER)
  designation    Designation?
  certificates       Certificate[]
  enrollments        Enrollment[]
  moduleProgress     ModuleProgress[]
  payments           Payment[]
  consultancyBookings ConsultancyBooking[]
  refreshTokens      RefreshToken[]
  cryoSearchState    CryoSearchState?
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CryoSearchState {
  id               String   @id @default(cuid())
  userId           String   @unique
  labs             Json
  activities       Json
  receivedRequests Json
  sentRequests     Json
  allowedUsers     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyMaterial {
  id          String              @id @default(cuid())
  title       String
  description String?
  category    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  files       StudyMaterialFile[]
}

model StudyMaterialFile {
  id         String        @id @default(cuid())
  materialId String
  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String        @unique
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

model ResearchKit {
  id              String   @id @default(cuid())
  title           String
  category        String
  imageStorageKey String?
  assays          String[]
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Course {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  category            String?
  thumbnailStorageKey String?
  price               Int                  @default(0)
  currency            String               @default("INR")
  accessDurationDays  Int                  @default(90)
  passingPercentage   Int                  @default(75)
  published           Boolean              @default(false)
  sortOrder           Int                  @default(0)
  reminderMode        ReminderMode         @default(AUTOMATIC)
  reminderDaysBefore  Int[]                @default([7, 3, 1])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  certificates        Certificate[]
  modules             CourseModule[]
  packageItems        CoursePackageItem[]
  prerequisites       CoursePrerequisite[] @relation("CoursePrerequisites")
  prerequisiteFor     CoursePrerequisite[] @relation("PrerequisiteCourses")
  enrollments         Enrollment[]
  payments            Payment[]
}

model CourseModule {
  id                  String            @id @default(cuid())
  courseId            String
  title               String
  description         String?
  contentType         ModuleContentType
  sortOrder           Int               @default(0)
  durationMinutes     Int?
  isRequired          Boolean           @default(true)
  storageKey          String?
  fileName            String?
  mimeType            String?
  fileSize            Int?
  contentJson         Json?
  videoWatchThreshold Float             @default(0.95)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress            ModuleProgress[]

  @@index([courseId])
}

model CoursePrerequisite {
  id                   String @id @default(cuid())
  courseId             String
  prerequisiteCourseId String
  course               Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse   Course @relation("PrerequisiteCourses", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
  @@index([courseId])
  @@index([prerequisiteCourseId])
}

model CoursePackage {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  price              Int                 @default(0)
  currency           String              @default("INR")
  accessDurationDays Int                 @default(90)
  published          Boolean             @default(false)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              CoursePackageItem[]
  enrollments        Enrollment[]
  payments           Payment[]
}

model CoursePackageItem {
  id        String        @id @default(cuid())
  packageId String
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, courseId])
  @@index([packageId])
  @@index([courseId])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String?
  packageId   String?
  status      EnrollmentStatus @default(ACTIVE)
  purchasedAt DateTime         @default(now())
  expiresAt   DateTime
  paymentId   String?
  reminders   CourseReminder[]
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  package     CoursePackage?   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment     Payment?         @relation(fields: [paymentId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([packageId])
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  courseId          String?
  packageId         String?
  amount            Int
  currency          String          @default("INR")
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  enrollments       Enrollment[]
  course            Course?         @relation(fields: [courseId], references: [id])
  package           CoursePackage?  @relation(fields: [packageId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerOrderId])
}

model ModuleProgress {
  id                    String       @id @default(cuid())
  userId                String
  moduleId              String
  startedAt             DateTime     @default(now())
  completedAt           DateTime?
  watchProgress         Float        @default(0)
  quizScore             Float?
  quizPassed            Boolean?
  assignmentSubmission  String?
  assignmentSubmittedAt DateTime?
  module                CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  certificateNumber String   @unique
  verificationHash  String   @unique
  issuedAt          DateTime @default(now())
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ConsultancyCategory {
  id          String       @id @default(cuid())
  name        String
  description String?
  color       String?
  published   Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  consultants Consultant[]
  bookings    ConsultancyBooking[]

  @@index([published, sortOrder])
}

model Consultant {
  id                 String                @id @default(cuid())
  categoryId         String?
  name               String
  title              String?
  photoUrl           String?
  expertise          String[]
  experienceYears    Int                   @default(0)
  bio                String?
  consultationTypes  String[]              @default(["VIDEO", "AUDIO"])
  durationMinutes    Int                   @default(60)
  hourlyRate         Int                   @default(0)
  currency           String                @default("INR")
  available          Boolean               @default(true)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  category           ConsultancyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slots              ConsultantSlot[]
  bookings           ConsultancyBooking[]

  @@index([categoryId])
  @@index([available, sortOrder])
}

model ConsultantSlot {
  id          String               @id @default(cuid())
  consultantId String
  date        DateTime
  startTime   String
  endTime     String
  isBooked    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  consultant  Consultant           @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  bookings    ConsultancyBooking[]

  @@index([consultantId, date])
  @@unique([consultantId, date, startTime, endTime])
}

model ConsultancyBooking {
  id               String              @id @default(cuid())
  userId           String
  consultantId     String
  categoryId       String?
  slotId           String
  amount           Int
  currency         String              @default("INR")
  consultationType String
  status           ConsultancyStatus   @default(PENDING)
  provider         PaymentProvider     @default(RAZORPAY)
  providerOrderId  String?
  providerPaymentId String?
  userName         String?
  userEmail        String?
  userPhone        String?
  notes            String?
  date             DateTime
  startTime        String
  endTime          String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultant       Consultant          @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  category         ConsultancyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slot             ConsultantSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consultantId])
  @@index([status])
  @@index([providerOrderId])
}

model CourseReminder {
  id           String     @id @default(cuid())
  enrollmentId String
  sentAt       DateTime   @default(now())
  reminderType String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model OtpCode {
  id        String     @id
  email     String
  codeHash  String
  purpose   OtpPurpose
  payload   Json?
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

enum UserRole {
  USER
  ADMIN
}

enum Designation {
  PHD
  MD
  MSC
  BSC
  BTECH
  MTECH
  POSTDOC
  PROFESSOR
  RESEARCH_SCIENTIST
  GRADUATE_STUDENT
  UNDERGRADUATE
  OTHER
}

enum ModuleContentType {
  VIDEO
  PDF
  PPT
  ASSIGNMENT
  QUIZ
  TEXT
  IMAGE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ConsultancyStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentProvider {
  RAZORPAY
  MANUAL
}

enum ReminderMode {
  AUTOMATIC
  MANUAL
  OFF
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
}
