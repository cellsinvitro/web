generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String?
  name           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  googleId       String?          @unique
  avatarUrl      String?
  role           UserRole         @default(USER)
  designation    Designation?
  certificates       Certificate[]
  enrollments        Enrollment[]
  moduleProgress     ModuleProgress[]
  payments           Payment[]
  kitOrderEvents     KitOrderEvent[] @relation("KitOrderEventActor")
  liveClassesAsTeacher LiveClass[] @relation("LiveClassTeacher")
  liveClassEnrollments LiveClassEnrollment[]
  liveClassAttendance  LiveClassAttendance[]
  consultancyBookings ConsultancyBooking[]
  studyMaterialDownloads StudyMaterialDownload[]
  refreshTokens      RefreshToken[]
  cryoSearchState    CryoSearchState?
  maintenanceRules   MaintenanceRule[]
}

model MaintenanceRule {
  id          String          @id @default(cuid())
  targetPath  String
  scope       MaintenanceScope
  enabled     Boolean         @default(true)
  message     String?
  createdById  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([scope, targetPath])
  @@index([scope, enabled])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CryoSearchState {
  id               String   @id @default(cuid())
  userId           String   @unique
  labs             Json
  activities       Json
  receivedRequests Json
  sentRequests     Json
  allowedUsers     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyMaterial {
  id          String              @id @default(cuid())
  title       String
  description String?
  category    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  files       StudyMaterialFile[]
}

model StudyMaterialFile {
  id         String        @id @default(cuid())
  materialId String
  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String        @unique
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  downloads  StudyMaterialDownload[]

  @@index([materialId])
}

model StudyMaterialDownload {
  id         String            @id @default(cuid())
  userId     String
  fileId     String
  createdAt  DateTime          @default(now())
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  file       StudyMaterialFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([fileId, createdAt])
}

model ResearchKit {
  id              String   @id @default(cuid())
  title           String
  category        String
  imageStorageKey String?
  assays          String[]
  details         String?
  price           Int      @default(0)
  stock           Int      @default(0)
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        Payment[]
}

model Course {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  category            String?
  thumbnailStorageKey String?
  price               Int                  @default(0)
  currency            String               @default("INR")
  accessDurationDays  Int                  @default(90)
  passingPercentage   Int                  @default(75)
  published           Boolean              @default(false)
  sortOrder           Int                  @default(0)
  reminderMode        ReminderMode         @default(AUTOMATIC)
  reminderDaysBefore  Int[]                @default([7, 3, 1])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  certificates        Certificate[]
  modules             CourseModule[]
  packageItems        CoursePackageItem[]
  prerequisites       CoursePrerequisite[] @relation("CoursePrerequisites")
  prerequisiteFor     CoursePrerequisite[] @relation("PrerequisiteCourses")
  enrollments         Enrollment[]
  payments            Payment[]
  liveClasses         LiveClass[]
}

model CourseModule {
  id                  String            @id @default(cuid())
  courseId            String
  title               String
  description         String?
  contentType         ModuleContentType
  sortOrder           Int               @default(0)
  durationMinutes     Int?
  isRequired          Boolean           @default(true)
  storageKey          String?
  fileName            String?
  mimeType            String?
  fileSize            Int?
  contentJson         Json?
  videoWatchThreshold Float             @default(0.95)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress            ModuleProgress[]

  @@index([courseId])
}

model CoursePrerequisite {
  id                   String @id @default(cuid())
  courseId             String
  prerequisiteCourseId String
  course               Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse   Course @relation("PrerequisiteCourses", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
  @@index([courseId])
  @@index([prerequisiteCourseId])
}

model CoursePackage {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  price              Int                 @default(0)
  currency           String              @default("INR")
  accessDurationDays Int                 @default(90)
  published          Boolean             @default(false)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              CoursePackageItem[]
  enrollments        Enrollment[]
  payments           Payment[]
}

model CoursePackageItem {
  id        String        @id @default(cuid())
  packageId String
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, courseId])
  @@index([packageId])
  @@index([courseId])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String?
  packageId   String?
  status      EnrollmentStatus @default(ACTIVE)
  purchasedAt DateTime         @default(now())
  expiresAt   DateTime
  paymentId   String?
  reminders   CourseReminder[]
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  package     CoursePackage?   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment     Payment?         @relation(fields: [paymentId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([packageId])
}

model Payment {
  id                String          @id @default(cuid())
  userId            String
  courseId          String?
  packageId         String?
  kitId             String?
  quantity          Int             @default(1)
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  shippingAddress   String?
  itemTitle         String?
  unitAmount        Int?
  fulfillmentStatus KitFulfillmentStatus?
  carrier           String?
  trackingNumber    String?
  estimatedDeliveryAt DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  amount            Int
  currency          String          @default("INR")
  provider          PaymentProvider @default(RAZORPAY)
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  completedAt       DateTime?
  enrollments       Enrollment[]
  liveClassEnrollments LiveClassEnrollment[]
  liveClass          LiveClass? @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  liveClassId        String?
  course            Course?         @relation(fields: [courseId], references: [id])
  package           CoursePackage?  @relation(fields: [packageId], references: [id])
  kit               ResearchKit?    @relation(fields: [kitId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitOrderEvents    KitOrderEvent[]

  @@index([userId])
  @@index([providerOrderId])
  @@index([liveClassId])
  @@index([kitId])
}

model KitOrderEvent {
  id        String             @id @default(cuid())
  paymentId String
  status    KitFulfillmentStatus
  note      String?
  location  String?
  actorId   String?
  createdAt DateTime           @default(now())
  payment   Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor     User?              @relation("KitOrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([status])
}

model LiveClass {
  id                    String           @id @default(cuid())
  title                 String
  description           String?
  thumbnail             String?
  courseId              String?
  teacherId             String
  roomName              String           @unique
  scheduledAt           DateTime
  startTime             String
  duration              Int
  maxParticipants       Int              @default(100)
  price                 Int              @default(0)
  currency              String           @default("INR")
  isPaid                Boolean          @default(false)
  studentCameraEnabled  Boolean          @default(true)
  studentMicrophoneEnabled Boolean       @default(true)
  chatEnabled           Boolean          @default(true)
  recordingEnabled      Boolean          @default(false)
  status                LiveClassStatus  @default(SCHEDULED)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  course                Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher               User             @relation("LiveClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments           LiveClassEnrollment[]
  attendance            LiveClassAttendance[]
  payments              Payment[]

  @@index([scheduledAt, status])
  @@index([teacherId])
  @@index([courseId])
}

model LiveClassEnrollment {
  id          String                    @id @default(cuid())
  userId      String
  liveClassId String
  paymentId   String?
  status      LiveClassEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime                  @default(now())
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveClass   LiveClass                 @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  payment     Payment?                  @relation(fields: [paymentId], references: [id])

  @@unique([userId, liveClassId])
  @@index([liveClassId])
}

model LiveClassAttendance {
  id          String           @id @default(cuid())
  userId      String
  liveClassId String
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?
  duration    Int              @default(0)
  status      AttendanceStatus @default(PRESENT)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveClass   LiveClass        @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@index([userId, liveClassId])
  @@index([liveClassId, joinedAt])
}

model LiveClassWebhookEvent {
  id        String   @id
  event     String
  createdAt DateTime @default(now())
}

model ModuleProgress {
  id                    String       @id @default(cuid())
  userId                String
  moduleId              String
  startedAt             DateTime     @default(now())
  completedAt           DateTime?
  watchProgress         Float        @default(0)
  quizScore             Float?
  quizPassed            Boolean?
  assignmentSubmission  String?
  assignmentSubmittedAt DateTime?
  module                CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  certificateNumber String   @unique
  verificationHash  String   @unique
  issuedAt          DateTime @default(now())
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ConsultancyCategory {
  id          String       @id @default(cuid())
  name        String
  description String?
  color       String?
  published   Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  consultants Consultant[]
  bookings    ConsultancyBooking[]

  @@index([published, sortOrder])
}

model Consultant {
  id                 String                @id @default(cuid())
  categoryId         String?
  name               String
  title              String?
  photoUrl           String?
  expertise          String[]
  experienceYears    Int                   @default(0)
  bio                String?
  consultationTypes  String[]              @default(["VIDEO", "AUDIO"])
  durationMinutes    Int                   @default(60)
  hourlyRate         Int                   @default(0)
  currency           String                @default("INR")
  available          Boolean               @default(true)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  category           ConsultancyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slots              ConsultantSlot[]
  bookings           ConsultancyBooking[]

  @@index([categoryId])
  @@index([available, sortOrder])
}

model ConsultantSlot {
  id          String               @id @default(cuid())
  consultantId String
  date        DateTime
  startTime   String
  endTime     String
  isBooked    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  consultant  Consultant           @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  bookings    ConsultancyBooking[]

  @@index([consultantId, date])
  @@unique([consultantId, date, startTime, endTime])
}

model ConsultancyBooking {
  id               String              @id @default(cuid())
  userId           String
  consultantId     String
  categoryId       String?
  slotId           String
  amount           Int
  currency         String              @default("INR")
  consultationType String
  status           ConsultancyStatus   @default(PENDING)
  provider         PaymentProvider     @default(RAZORPAY)
  providerOrderId  String?
  providerPaymentId String?
  userName         String?
  userEmail        String?
  userPhone        String?
  notes            String?
  date             DateTime
  startTime        String
  endTime          String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultant       Consultant          @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  category         ConsultancyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slot             ConsultantSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consultantId])
  @@index([status])
  @@index([providerOrderId])
}

model CourseReminder {
  id           String     @id @default(cuid())
  enrollmentId String
  sentAt       DateTime   @default(now())
  reminderType String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model OtpCode {
  id        String     @id
  email     String
  codeHash  String
  purpose   OtpPurpose
  payload   Json?
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

enum UserRole {
  USER
  ADMIN
}

enum MaintenanceScope {
  WEB_PATH
  API_PATH
}

enum Designation {
  PHD
  MD
  MSC
  BSC
  BTECH
  MTECH
  POSTDOC
  PROFESSOR
  RESEARCH_SCIENTIST
  GRADUATE_STUDENT
  UNDERGRADUATE
  OTHER
}

enum ModuleContentType {
  VIDEO
  PDF
  PPT
  ASSIGNMENT
  QUIZ
  TEXT
  IMAGE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum KitFulfillmentStatus {
  PROCESSING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum ConsultancyStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentProvider {
  RAZORPAY
  MANUAL
}

enum ReminderMode {
  AUTOMATIC
  MANUAL
  OFF
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveClassEnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LEFT
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  LOGIN
}
