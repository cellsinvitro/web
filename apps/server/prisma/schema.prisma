generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String?
  name           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  googleId       String?          @unique
  avatarUrl      String?
  role           UserRole         @default(USER)
  designation    Designation?
  certificates       Certificate[]
  enrollments        Enrollment[]
  moduleProgress     ModuleProgress[]
  payments           Payment[]
  kitOrderEvents     KitOrderEvent[] @relation("KitOrderEventActor")
  liveClassesAsTeacher LiveClass[] @relation("LiveClassTeacher")
  liveClassEnrollments LiveClassEnrollment[]
  liveClassAttendance  LiveClassAttendance[]
  consultancyBookings ConsultancyBooking[]
  studyMaterialDownloads StudyMaterialDownload[]
  refreshTokens      RefreshToken[]
  cryoSearchState    CryoSearchState?
  cryoInvites        CryoInvite[]
  maintenanceRules   MaintenanceRule[]
  resourceAccesses   ResourceAccess[]
  toolUsages         ToolUsage[]
  budgets            Budget[]
  budgetSubmissions  BudgetSubmission[]
  instrumentBookings InstrumentBooking[]
  logbookPermission  LogbookPermission?
  labNotebookEntries LabNotebookEntry[]
  labWorkspacesOwned LabWorkspace[]     @relation("LabWorkspaceOwner")
  labMemberships     LabMember[]
  labInvitesSent     LabInvite[]        @relation("LabInviteInviter")
  stockItemsCreated  StockItem[]        @relation("StockItemCreator")
  stockTransactionsCreated StockTransaction[] @relation("StockTransactionCreator")
  notebookTasksAssigned  NotebookTask[]   @relation("NotebookTaskAssignee")
  notebookTasksCreated   NotebookTask[]   @relation("NotebookTaskAssigner")
  lmsAccesses            LmsAccess[]
}

model MaintenanceRule {
  id          String          @id @default(cuid())
  targetPath  String
  scope       MaintenanceScope
  enabled     Boolean         @default(true)
  message     String?
  createdById  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([scope, targetPath])
  @@index([scope, enabled])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CryoSearchState {
  id               String   @id @default(cuid())
  userId           String   @unique
  labs             Json
  activities       Json
  receivedRequests Json
  sentRequests     Json
  allowedUsers     Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CryoInvite {
  id            String    @id @default(cuid())
  token         String    @unique
  ownerId       String
  inviteeEmail  String
  itemId        String
  usedAt        DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([ownerId])
}

model ToolSetting {
  toolKey    String   @id
  usageLimit Int?
  updatedAt  DateTime @updatedAt
}

model ToolUsage {
  id        String   @id @default(cuid())
  userId    String
  toolKey   String
  usageCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolKey])
  @@index([toolKey])
}

model ResourceLibrarySetting {
  id        String   @id @default("default")
  price     Int      @default(0)
  originalPrice Int?
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt
}

model LmsSetting {
  id                    String   @id @default("default")
  repoPrice             Int      @default(149900)
  stockPrice            Int      @default(149900)
  budgetPrice           Int      @default(149900)
  logbookPrice          Int      @default(199900)
  twoSectionDiscountPct  Int      @default(15)
  threeSectionDiscountPct Int      @default(25)
  fullAccessPrice       Int      @default(399900)
  currency              String   @default("INR")
  updatedAt             DateTime @updatedAt
}

model LmsAccess {
  id          String   @id @default(cuid())
  userId      String
  section     String   // "lms_repo" | "lms_stock" | "lms_budget" | "lms_logbook" | "lms_full"
  grantedBy   String   @default("PAYMENT") // "PAYMENT" | "ADMIN"
  paymentId   String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([userId, section])
  @@index([userId])
}

model StudyMaterial {
  id               String              @id @default(cuid())
  title            String
  description      String?
  category         String?
  price            Int                 @default(0)
  originalPrice    Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  files            StudyMaterialFile[]
  resourceAccesses ResourceAccess[]
  payments         Payment[]
}

model StudyMaterialFile {
  id               String                  @id @default(cuid())
  materialId       String
  fileName         String
  mimeType         String
  fileSize         Int
  storageKey       String                  @unique
  price            Int                     @default(0)
  originalPrice    Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  material         StudyMaterial           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  downloads        StudyMaterialDownload[]
  resourceAccesses ResourceAccess[]
  payments         Payment[]

  @@index([materialId])
}

model ResourceAccess {
  id         String              @id @default(cuid())
  userId     String
  scope      ResourceAccessScope
  materialId String?
  fileId     String?
  paymentId  String?
  createdAt  DateTime            @default(now())

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  material StudyMaterial?     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  file     StudyMaterialFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  payment  Payment?           @relation(fields: [paymentId], references: [id])

  @@unique([userId, scope, materialId, fileId])
  @@index([userId])
  @@index([materialId])
  @@index([fileId])
}

model StudyMaterialDownload {
  id        String            @id @default(cuid())
  userId    String
  fileId    String
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      StudyMaterialFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([fileId, createdAt])
}

model ResearchKit {
  id              String   @id @default(cuid())
  title           String
  category        String
  imageStorageKey String?
  assays          String[]
  details         String?
  price           Int      @default(0)
  originalPrice   Int?
  stock           Int      @default(0)
  published       Boolean  @default(true)
  sortOrder       Int      @default(0)
  moduleId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  module          KitModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  payments        Payment[]

  @@index([moduleId, sortOrder])
}

model KitModule {
  id          String      @id @default(cuid())
  title       String
  description String?
  imageStorageKey String?
  parentId    String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  parent      KitModule?  @relation("KitModuleTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    KitModule[] @relation("KitModuleTree")
  kits        ResearchKit[]

  @@index([parentId, sortOrder])
}

model Course {
  id                  String               @id @default(cuid())
  title               String
  description         String?
  category            String?
  thumbnailStorageKey String?
  price               Int                  @default(0)
  originalPrice       Int?
  currency            String               @default("INR")
  accessDurationDays  Int                  @default(90)
  passingPercentage   Int                  @default(75)
  published           Boolean              @default(false)
  sortOrder           Int                  @default(0)
  reminderMode        ReminderMode         @default(AUTOMATIC)
  reminderDaysBefore  Int[]                @default([7, 3, 1])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  certificates        Certificate[]
  modules             CourseModule[]
  packageItems        CoursePackageItem[]
  prerequisites       CoursePrerequisite[] @relation("CoursePrerequisites")
  prerequisiteFor     CoursePrerequisite[] @relation("PrerequisiteCourses")
  enrollments         Enrollment[]
  payments            Payment[]
  liveClasses         LiveClass[]
}

model CourseModule {
  id                  String            @id @default(cuid())
  courseId            String
  title               String
  description         String?
  contentType         ModuleContentType
  sortOrder           Int               @default(0)
  durationMinutes     Int?
  isRequired          Boolean           @default(true)
  storageKey          String?
  fileName            String?
  mimeType            String?
  fileSize            Int?
  contentJson         Json?
  videoWatchThreshold Float             @default(0.95)
  questionsPerAttempt Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  course              Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress            ModuleProgress[]

  @@index([courseId])
}

model CoursePrerequisite {
  id                   String @id @default(cuid())
  courseId             String
  prerequisiteCourseId String
  course               Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourse   Course @relation("PrerequisiteCourses", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
  @@index([courseId])
  @@index([prerequisiteCourseId])
}

model CoursePackage {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  price              Int                 @default(0)
  originalPrice      Int?
  currency           String              @default("INR")
  accessDurationDays Int                 @default(90)
  published          Boolean             @default(false)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  items              CoursePackageItem[]
  enrollments        Enrollment[]
  payments           Payment[]
}

model CoursePackageItem {
  id        String        @id @default(cuid())
  packageId String
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, courseId])
  @@index([packageId])
  @@index([courseId])
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String?
  packageId   String?
  status      EnrollmentStatus @default(ACTIVE)
  purchasedAt DateTime         @default(now())
  expiresAt   DateTime
  paymentId   String?
  reminders   CourseReminder[]
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  package     CoursePackage?   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  payment     Payment?         @relation(fields: [paymentId], references: [id])
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([packageId])
}

model Payment {
  id                  String               @id @default(cuid())
  userId              String
  courseId            String?
  packageId           String?
  kitId               String?
  studyMaterialId     String?
  studyMaterialFileId String?
  resourceScope       ResourceAccessScope?
  quantity            Int                  @default(1)
  customerName        String?
  customerEmail       String?
  customerPhone       String?
  shippingAddress     String?
  itemTitle           String?
  unitAmount          Int?
  fulfillmentStatus   KitFulfillmentStatus?
  carrier             String?
  trackingNumber      String?
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  amount              Int
  currency            String               @default("INR")
  provider            PaymentProvider      @default(RAZORPAY)
  providerOrderId     String?
  providerPaymentId   String?
  status              PaymentStatus        @default(PENDING)
  createdAt           DateTime             @default(now())
  completedAt         DateTime?
  enrollments         Enrollment[]
  liveClassEnrollments LiveClassEnrollment[]
  liveClass           LiveClass?           @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  liveClassId         String?
  course              Course?              @relation(fields: [courseId], references: [id])
  package             CoursePackage?       @relation(fields: [packageId], references: [id])
  kit                 ResearchKit?         @relation(fields: [kitId], references: [id])
  studyMaterial       StudyMaterial?       @relation(fields: [studyMaterialId], references: [id])
  studyMaterialFile   StudyMaterialFile?   @relation(fields: [studyMaterialFileId], references: [id])
  resourceAccesses    ResourceAccess[]
  lmsSections         String[]
  lmsAccesses         LmsAccess[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitOrderEvents      KitOrderEvent[]

  @@index([userId])
  @@index([providerOrderId])
  @@index([liveClassId])
  @@index([kitId])
  @@index([studyMaterialId])
  @@index([studyMaterialFileId])
}

model KitOrderEvent {
  id        String             @id @default(cuid())
  paymentId String
  status    KitFulfillmentStatus
  note      String?
  location  String?
  actorId   String?
  createdAt DateTime           @default(now())
  payment   Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor     User?              @relation("KitOrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([status])
}

model LiveClass {
  id                    String           @id @default(cuid())
  title                 String
  description           String?
  thumbnail             String?
  courseId              String?
  teacherId             String
  roomName              String           @unique
  scheduledAt           DateTime
  startTime             String
  duration              Int
  maxParticipants       Int              @default(100)
  price                 Int              @default(0)
  originalPrice         Int?
  currency              String           @default("INR")
  isPaid                Boolean          @default(false)
  studentCameraEnabled  Boolean          @default(true)
  studentMicrophoneEnabled Boolean       @default(true)
  chatEnabled           Boolean          @default(true)
  recordingEnabled      Boolean          @default(false)
  status                LiveClassStatus  @default(SCHEDULED)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  course                Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacher               User             @relation("LiveClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments           LiveClassEnrollment[]
  attendance            LiveClassAttendance[]
  payments              Payment[]

  @@index([scheduledAt, status])
  @@index([teacherId])
  @@index([courseId])
}

model LiveClassEnrollment {
  id          String                    @id @default(cuid())
  userId      String
  liveClassId String
  paymentId   String?
  status      LiveClassEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime                  @default(now())
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveClass   LiveClass                 @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  payment     Payment?                  @relation(fields: [paymentId], references: [id])

  @@unique([userId, liveClassId])
  @@index([liveClassId])
}

model LiveClassAttendance {
  id          String           @id @default(cuid())
  userId      String
  liveClassId String
  joinedAt    DateTime         @default(now())
  leftAt      DateTime?
  duration    Int              @default(0)
  status      AttendanceStatus @default(PRESENT)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveClass   LiveClass        @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@index([userId, liveClassId])
  @@index([liveClassId, joinedAt])
}

model LiveClassWebhookEvent {
  id        String   @id
  event     String
  createdAt DateTime @default(now())
}

model ModuleProgress {
  id                    String       @id @default(cuid())
  userId                String
  moduleId              String
  startedAt             DateTime     @default(now())
  completedAt           DateTime?
  watchProgress         Float        @default(0)
  quizScore             Float?
  quizPassed            Boolean?
  assignmentSubmission  String?
  assignmentSubmittedAt DateTime?
  module                CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model Certificate {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  certificateNumber String   @unique
  verificationHash  String   @unique
  issuedAt          DateTime @default(now())
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ConsultancyCategory {
  id          String       @id @default(cuid())
  name        String
  description String?
  color       String?
  published   Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  consultants Consultant[]
  bookings    ConsultancyBooking[]

  @@index([published, sortOrder])
}

model Consultant {
  id                 String                @id @default(cuid())
  categoryId         String?
  name               String
  title              String?
  photoUrl           String?
  expertise          String[]
  experienceYears    Int                   @default(0)
  bio                String?
  consultationTypes  String[]              @default(["VIDEO", "AUDIO"])
  durationMinutes    Int                   @default(60)
  hourlyRate         Int                   @default(0)
  currency           String                @default("INR")
  available          Boolean               @default(true)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  category           ConsultancyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slots              ConsultantSlot[]
  bookings           ConsultancyBooking[]

  @@index([categoryId])
  @@index([available, sortOrder])
}

model ConsultantSlot {
  id          String               @id @default(cuid())
  consultantId String
  date        DateTime
  startTime   String
  endTime     String
  isBooked    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  consultant  Consultant           @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  bookings    ConsultancyBooking[]

  @@index([consultantId, date])
  @@unique([consultantId, date, startTime, endTime])
}

model ConsultancyBooking {
  id               String              @id @default(cuid())
  userId           String
  consultantId     String
  categoryId       String?
  slotId           String
  amount           Int
  currency         String              @default("INR")
  consultationType String
  status           ConsultancyStatus   @default(PENDING)
  provider         PaymentProvider     @default(RAZORPAY)
  providerOrderId  String?
  providerPaymentId String?
  userName         String?
  userEmail        String?
  userPhone        String?
  notes            String?
  date             DateTime
  startTime        String
  endTime          String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultant       Consultant          @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  category         ConsultancyCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slot             ConsultantSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consultantId])
  @@index([status])
  @@index([providerOrderId])
}

model CourseReminder {
  id           String     @id @default(cuid())
  enrollmentId String
  sentAt       DateTime   @default(now())
  reminderType String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
}

model OtpCode {
  id        String     @id
  email     String
  codeHash  String
  purpose   OtpPurpose
  payload   Json?
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

enum UserRole {
  USER
  ADMIN
}

enum MaintenanceScope {
  WEB_PATH
  API_PATH
}

enum Designation {
  PHD
  MD
  MSC
  BSC
  BTECH
  MTECH
  POSTDOC
  PROFESSOR
  RESEARCH_SCIENTIST
  GRADUATE_STUDENT
  UNDERGRADUATE
  OTHER
}

enum ModuleContentType {
  VIDEO
  PDF
  PPT
  ASSIGNMENT
  QUIZ
  TEXT
  IMAGE
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum KitFulfillmentStatus {
  PROCESSING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum ConsultancyStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentProvider {
  RAZORPAY
  MANUAL
}

enum ReminderMode {
  AUTOMATIC
  MANUAL
  OFF
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveClassEnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LEFT
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  LOGIN
}

enum ResourceAccessScope {
  FULL_LIBRARY
  MODULE
  FILE
}

// ─── Budget Management ────────────────────────────────────────────────────────

/// A budget created by any user. They set the initial allocation.
model Budget {
  id              String             @id @default(cuid())
  ownerId         String
  name            String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  allocatedAmount Int                // paise (rupees × 100)
  currency        String             @default("INR")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fields          BudgetFormField[]
  submissions     BudgetSubmission[]
  heads           BudgetHead[]

  @@index([ownerId, createdAt])
}

/// A named category / section within a budget (e.g. "Equipment", "Salary").
model BudgetHead {
  id          String             @id @default(cuid())
  budgetId    String
  name        String
  description String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  budget      Budget             @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  fields      BudgetFormField[]
  submissions BudgetSubmission[]

  @@index([budgetId, sortOrder])
}

/// Per-budget form field — configured by the budget owner.
model BudgetFormField {
  id           String               @id @default(cuid())
  budgetId     String
  headId       String?              // optional: field belongs to a budget head section
  label        String
  fieldType    BudgetFieldType      // TEXT | NUMBER | DATE
  direction    BudgetFieldDirection @default(NONE) // only meaningful for NUMBER fields
  defaultValue String?              // pre-filled value shown in the submission form
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  budget       Budget               @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  head         BudgetHead?          @relation(fields: [headId], references: [id], onDelete: SetNull)
  values       BudgetSubmissionValue[]

  @@index([budgetId, sortOrder])
  @@index([headId])
}

/// One form submission against a budget.
model BudgetSubmission {
  id          String                 @id @default(cuid())
  budgetId    String
  headId      String?                // optional: submission belongs to a budget head section
  userId      String
  submittedAt DateTime               @default(now())
  /// Net paise applied to budget: positive = net expense, negative = net addition
  netEffect   Int                    @default(0)
  note        String?                // free-text note shown in submission history
  budget      Budget                 @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  head        BudgetHead?            @relation(fields: [headId], references: [id], onDelete: SetNull)
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  values      BudgetSubmissionValue[]

  @@index([budgetId, submittedAt])
  @@index([headId])
  @@index([userId])
}

/// One field value within a submission.
model BudgetSubmissionValue {
  id           String           @id @default(cuid())
  submissionId String
  fieldId      String
  value        String           // stored as text; numbers parsed on read
  submission   BudgetSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field        BudgetFormField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
  @@index([submissionId])
  @@index([fieldId])
}

enum BudgetFieldType {
  TEXT
  NUMBER
  DATE
}

enum BudgetFieldDirection {
  EXPENSE   // subtracts from remaining balance
  ADDITION  // adds to remaining balance
  NONE      // informational only (TEXT / DATE fields)
}

// ─── Lab Log-Book & Instrument Logbook ───────────────────────────────────────

enum InstrumentStatus {
  ACTIVE
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  ARCHIVED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum LabMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum LabInviteStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model LabWorkspace {
  id           String             @id @default(cuid())
  name         String
  description  String?
  ownerId      String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  owner        User               @relation("LabWorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members      LabMember[]
  invites      LabInvite[]
  instruments  Instrument[]
  activities   LogbookActivity[]
  notebooks    LabNotebookEntry[]
  notebookTasks    NotebookTask[]
  notebookActivityLogs NotebookActivityLog[]
  stockSettings    StockSettings?
  stockCategories  StockCategory[]
  stockTags        StockTag[]
  locations        Location[]
  stockItems       StockItem[]
  stockTransactions StockTransaction[]
  stockActivityLogs StockActivityLog[]

  @@index([ownerId])
}

model LabMember {
  id                      String        @id @default(cuid())
  labId                   String
  userId                  String
  role                    LabMemberRole @default(MEMBER)
  // Logbook permissions
  canViewLogbook          Boolean       @default(true)
  canCreateEntries        Boolean       @default(true)
  canEditOwnEntries       Boolean       @default(true)
  canEditOthersEntries    Boolean       @default(false)
  canManageInstruments    Boolean       @default(false)
  canGenerateReports      Boolean       @default(false)
  // Stock Management permissions
  canViewStock            Boolean       @default(false)
  canAddStock             Boolean       @default(false)
  canEditStock            Boolean       @default(false)
  canIssueStock           Boolean       @default(true)
  canRestockStock         Boolean       @default(false)
  canManageStockSettings  Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  lab                     LabWorkspace  @relation(fields: [labId], references: [id], onDelete: Cascade)
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([labId, userId])
  @@index([labId])
  @@index([userId])
}

model LabInvite {
  id                      String          @id @default(cuid())
  labId                   String
  inviterId               String
  inviteeEmail            String
  role                    LabMemberRole   @default(MEMBER)
  canViewStock            Boolean         @default(true)
  canAddStock             Boolean         @default(true)
  canEditStock            Boolean         @default(false)
  canIssueStock           Boolean         @default(true)
  canRestockStock         Boolean         @default(false)
  canManageStockSettings  Boolean         @default(false)
  token                   String          @unique
  status                  LabInviteStatus @default(PENDING)
  expiresAt               DateTime
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  lab                     LabWorkspace    @relation(fields: [labId], references: [id], onDelete: Cascade)
  inviter                 User            @relation("LabInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([inviteeEmail])
}

model Instrument {
  id               String              @id @default(cuid())
  code             String
  name             String
  installedOn      DateTime?
  lastServiceDate  DateTime?
  lastCleaningDate DateTime?
  nextServiceDate  DateTime?
  inchargeName     String?
  inchargeContact  String?
  description      String?
  status           InstrumentStatus    @default(ACTIVE)
  labId            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  bookings         InstrumentBooking[]
  activities       LogbookActivity[]
  lab              LabWorkspace?       @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([code])
}

model InstrumentBooking {
  id            String        @id @default(cuid())
  instrumentId  String
  userId        String
  userName      String
  date          DateTime
  startTime     String        // e.g. "11:30"
  endTime       String        // e.g. "12:30"
  startDateTime DateTime
  endDateTime   DateTime
  remarks       String?
  status        BookingStatus @default(CONFIRMED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     String
  instrument    Instrument    @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([instrumentId, date])
  @@index([instrumentId, startDateTime, endDateTime])
  @@index([userId])
}

model LogbookPermission {
  id                   String   @id @default(cuid())
  userId               String   @unique
  canViewLogbook       Boolean  @default(true)
  canCreateEntries     Boolean  @default(true)
  canEditOwnEntries    Boolean  @default(true)
  canEditOthersEntries Boolean  @default(false)
  canManageInstruments Boolean  @default(false)
  canGenerateReports   Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LogbookActivity {
  id           String        @id @default(cuid())
  labId        String?
  userId       String
  userName     String
  action       String        // e.g. "BOOKING_CREATED", "BOOKING_CANCELLED", "INSTRUMENT_UPDATED"
  details      String
  instrumentId String?
  createdAt    DateTime      @default(now())
  instrument   Instrument?   @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  lab          LabWorkspace? @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([userId])
  @@index([instrumentId, createdAt])
}

model LabNotebookEntry {
  id          String        @id @default(cuid())
  labId       String?
  userId      String
  userName    String
  date        DateTime
  /// Plain-text fallback (legacy). New entries store rich content in richContent.
  content     String        @db.Text
  /// JSON-serialised array of NotebookBlock objects (rich editor state)
  richContent Json?
  /// Entry-level time annotation (HH:MM, e.g. "09:30")
  entryTime   String?
  /// Short summary / title shown on calendar popup
  summary     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab         LabWorkspace? @relation(fields: [labId], references: [id], onDelete: Cascade)
  activityLogs NotebookActivityLog[]

  @@index([labId])
  @@index([userId])
  @@index([date])
}

/// Assigned task from admin to a specific user
model NotebookTask {
  id            String           @id @default(cuid())
  labId         String?
  assignedToId  String           // target user
  assignedById  String           // admin/owner who assigned
  title         String
  description   String?          @db.Text
  dueDate       DateTime?
  status        NotebookTaskStatus @default(PENDING)
  completedAt   DateTime?
  completedNote String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assignedTo    User             @relation("NotebookTaskAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedBy    User             @relation("NotebookTaskAssigner", fields: [assignedById], references: [id], onDelete: Cascade)
  lab           LabWorkspace?    @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@index([labId])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
}

/// Immutable audit trail for notebook-specific actions
model NotebookActivityLog {
  id        String        @id @default(cuid())
  labId     String?
  userId    String
  userName  String
  action    String        // e.g. ENTRY_CREATED, ENTRY_UPDATED, TASK_ASSIGNED, TASK_COMPLETED
  details   String
  entryId   String?       // related LabNotebookEntry (nullable)
  targetUserId String?    // for task-related actions
  createdAt DateTime      @default(now())
  lab       LabWorkspace? @relation(fields: [labId], references: [id], onDelete: Cascade)
  entry     LabNotebookEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([labId, createdAt])
  @@index([userId])
  @@index([targetUserId])
}

enum NotebookTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── Stock Management ─────────────────────────────────────────────────────────

enum StockTransactionType {
  ADD
  ISSUE
  RESTOCK
  STOCKOUT
  ADJUSTMENT
  EDIT
  LOCATION_CHANGE
}

enum StorageTemperature {
  AMBIENT
  FRIDGE_2_8
  FREEZER_MINUS_20
  DEEP_FREEZER_MINUS_80
}

enum HazardStatus {
  HAZARDOUS
  NON_HAZARDOUS
}

/// Per-lab stock configuration (thresholds etc.)
model StockSettings {
  id                  String       @id @default(cuid())
  labId               String       @unique
  lowStockThreshold   Int          @default(5)
  nearExpiryDays      Int          @default(90)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  lab                 LabWorkspace @relation(fields: [labId], references: [id], onDelete: Cascade)
}

/// Per-lab item type categories (Chemical, Culture Ware, etc.)
model StockCategory {
  id         String       @id @default(cuid())
  labId      String
  name       String
  isDefault  Boolean      @default(false)
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  lab        LabWorkspace @relation(fields: [labId], references: [id], onDelete: Cascade)
  items      StockItem[]

  @@unique([labId, name])
  @@index([labId, sortOrder])
}

/// Per-lab experimental use tags (Cell Culture, DNA, RNA, etc.)
model StockTag {
  id         String         @id @default(cuid())
  labId      String
  name       String
  isDefault  Boolean        @default(false)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lab        LabWorkspace   @relation(fields: [labId], references: [id], onDelete: Cascade)
  items      StockItemTag[]

  @@unique([labId, name])
  @@index([labId, sortOrder])
}

/// Self-referencing hierarchical location tree (Main Store > Shelf A > Rack 1)
model Location {
  id         String       @id @default(cuid())
  labId      String
  name       String
  parentId   String?
  sortOrder  Int          @default(0)
  isDefault  Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  lab        LabWorkspace @relation(fields: [labId], references: [id], onDelete: Cascade)
  parent     Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Location[]   @relation("LocationTree")
  stockItems StockItem[]

  @@index([labId])
  @@index([parentId])
}

/// Core inventory record — quantity only changes via transactions
model StockItem {
  id                 String              @id @default(cuid())
  labId              String
  name               String
  casNo              String?
  make               String?
  catalogueNo        String?
  packSize           String?
  pricePaise         Int                 @default(0)  // price per unit in paise (₹ × 100)
  currentQty         Int                 @default(0)
  expiryDate         DateTime?
  categoryId         String?
  hazardStatus       HazardStatus        @default(NON_HAZARDOUS)
  storageTemperature StorageTemperature  @default(AMBIENT)
  locationId         String?
  remarks            String?
  isArchived         Boolean             @default(false)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lab                LabWorkspace        @relation(fields: [labId], references: [id], onDelete: Cascade)
  category           StockCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  location           Location?           @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy          User                @relation("StockItemCreator", fields: [createdById], references: [id])
  tags               StockItemTag[]
  transactionItems   StockTransactionItem[]
  activityLogs       StockActivityLog[]

  @@index([labId, isArchived])
  @@index([labId, categoryId])
  @@index([labId, locationId])
  @@index([expiryDate])
}

/// Many-to-many join between StockItem and StockTag
model StockItemTag {
  id         String    @id @default(cuid())
  itemId     String
  tagId      String
  item       StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag        StockTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([itemId, tagId])
  @@index([itemId])
  @@index([tagId])
}

/// A stock-changing operation (may contain multiple items for ISSUE)
model StockTransaction {
  id          String               @id @default(cuid())
  labId       String
  type        StockTransactionType
  createdById String
  purpose     String?              // e.g. "DNA Extraction"
  projectName String?
  reason      String?              // e.g. "Expired" for STOCKOUT
  remarks     String?
  createdAt   DateTime             @default(now())
  lab         LabWorkspace         @relation(fields: [labId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("StockTransactionCreator", fields: [createdById], references: [id])
  items       StockTransactionItem[]

  @@index([labId, createdAt])
  @@index([labId, type])
  @@index([createdById])
}

/// One line item within a StockTransaction
model StockTransactionItem {
  id            String           @id @default(cuid())
  transactionId String
  itemId        String
  quantity      Int
  previousQty   Int
  newQty        Int
  transaction   StockTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  item          StockItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([itemId])
}

/// Immutable audit trail — one entry per stock-changing event
model StockActivityLog {
  id            String               @id @default(cuid())
  labId         String
  userId        String
  userName      String
  action        StockTransactionType
  itemId        String?
  itemName      String               // snapshot at time of action
  quantityDelta Int
  previousQty   Int
  newQty        Int
  reason        String?
  purpose       String?
  remarks       String?
  createdAt     DateTime             @default(now())
  lab           LabWorkspace         @relation(fields: [labId], references: [id], onDelete: Cascade)
  item          StockItem?           @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([labId, createdAt])
  @@index([labId, userId])
  @@index([labId, itemId])
  @@index([labId, action])
}
