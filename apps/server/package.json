{
  "name": "server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "prisma generate && cross-env PORT=3000 tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.1",
    "dotenv": "^16.4.7",
    "hono": "^4.7.0",
    "jose": "^6.2.9",
    "pg": "^8.14.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.11",
    "cross-env": "^10.0.1",
    "eslint": "^9.39.1",
    "tsx": "^4.19.3",
    "typescript": "5.9.2"
  }
}
